# Frontend configuration
# Browser calls the API same-origin (/api/*); Next.js forwards it to the backend below.
BACKEND_INTERNAL_URL=http://127.0.0.1:9899

# Leave empty unless the backend has its own public hostname (e.g. https://api.example.com).
# NEXT_PUBLIC_* values are baked into the build — never point this at localhost for production.
NEXT_PUBLIC_API_URL=
