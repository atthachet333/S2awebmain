{
  "name": "s2-backend",
  "version": "1.0.0",
  "private": true,
  "description": "S2 Accounting Consultant — REST API backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/tests/*.test.js\""
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "nodemailer": "^9.0.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.13.1",
    "@types/nodemailer": "^8.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
