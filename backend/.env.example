# Backend configuration
NODE_ENV=development
PORT=9899

# Allowed browser origins for CORS (comma-separated, no trailing slash).
# Production: FRONTEND_URL=https://www.s2aconsultant.com,https://s2aconsultant.com
FRONTEND_URL=http://localhost:9898

# Number of proxy hops in front of the API whose X-Forwarded-For can be trusted.
# Production on this PC (Cloudflare → Next.js on :9898 → /api rewrite → backend on 127.0.0.1:9899): 1
# Next.js forwards the X-Forwarded-For that Cloudflare set, so 1 resolves the real visitor IP.
# Leave 0 when the API is reached directly, otherwise clients could spoof X-Forwarded-For.
TRUST_PROXY=0

# Email delivery (Resend HTTP API; this project does not use SMTP)
# Set real values only in the server environment / .env (never commit them).
RESEND_API_KEY=
MAIL_FROM=S2 Website <onboarding@resend.dev>
CONTACT_EMAIL=office@s2aconsultant.com
